    {
      "id": "ieee_details",
      "type": "text",
      "x": 700,
      "y": 470,
      "width": 240,
      "height": 140,
      "text": "IEEE 39-bus test system\nIEEE 421.5-2016 (AVR/PSS)\nIEEE 1547-2018 (DER)\nIEEE 1366 (Reliability)\nIEGC (Indian Grid Code)\n  - Freq: 49.5-50.5 Hz\n  - UFLS: 49.5/49.2/49.0\n  - AGC deadband: 0.03 Hz\nNERC BAL-001 (ACE)",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
