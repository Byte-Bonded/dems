    {
      "id": "summary_details",
      "type": "text",
      "x": 700,
      "y": 140,
      "width": 167.9477081298828,
      "height": 261.25,
      "text": "Total Buses: 117\nTotal Generators: 30\nTotal Lines: 138+\nTie-Lines: 6 configs (8 links)\n\nBase Frequency: 50 Hz (IEGC)\nVoltage: 0.95-1.05 pu (IEEE)\n\nDER per Area:\n  Solar PV: ~68 MW\n  Wind: ~83 MW\n  BESS: 40 MWh\n  EV Chargers: ~67\n  DR: ~12 MW\n\nTotal DER Capacity:\n  Solar: 205 MW | Wind: 250 MW\n  Battery: 120 MWh | EV: 200\n  DR: 36.5 MW",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 22,
      "version": 4,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773581091012,
      "link": null,
      "locked": false,
      "versionNonce": 1685908223,
      "index": "aL",
      "strokeStyle": "solid",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Total Buses: 117\nTotal Generators: 30\nTotal Lines: 138+\nTie-Lines: 6 configs (8 links)\n\nBase Frequency: 50 Hz (IEGC)\nVoltage: 0.95-1.05 pu (IEEE)\n\nDER per Area:\n  Solar PV: ~68 MW\n  Wind: ~83 MW\n  BESS: 40 MWh\n  EV Chargers: ~67\n  DR: ~12 MW\n\nTotal DER Capacity:\n  Solar: 205 MW | Wind: 250 MW\n  Battery: 120 MWh | EV: 200\n  DR: 36.5 MW",
      "autoResize": true,
