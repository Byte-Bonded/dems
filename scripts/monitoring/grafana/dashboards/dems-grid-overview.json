{
  "dashboard": {
    "title": "DEMS Grid Overview",
    "tags": ["dems", "power-grid", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "title": "System Overview",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "dems_total_generation_mw",
            "legendFormat": "Generation (MW)"
          }
        ]
      },
      {
        "title": "Total Load",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "dems_total_load_mw",
            "legendFormat": "Load (MW)"
          }
        ]
      },
      {
        "title": "System Losses",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "dems_total_losses_mw",
            "legendFormat": "Losses (MW)"
          }
        ]
      },
      {
        "title": "Grid Security",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "dems_grid_secure",
            "legendFormat": "Secure"
          }
        ]
      },
      {
        "title": "Power Flow (MW)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "dems_total_generation_mw",
            "legendFormat": "Generation"
          },
          {
            "expr": "dems_total_load_mw",
            "legendFormat": "Load"
          },
          {
            "expr": "dems_total_losses_mw",
            "legendFormat": "Losses"
          }
        ]
      },
      {
        "title": "Voltage Profile",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "dems_max_voltage_pu",
            "legendFormat": "Max Voltage"
          },
          {
            "expr": "dems_avg_voltage_pu",
            "legendFormat": "Avg Voltage"
          },
          {
            "expr": "dems_min_voltage_pu",
            "legendFormat": "Min Voltage"
          }
        ]
      },
      {
        "title": "System Frequency (Hz)",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "dems_system_frequency_hz",
            "legendFormat": "Frequency"
          }
        ]
      },
      {
        "title": "Voltage Violations",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "dems_voltage_violations",
            "legendFormat": "Violations"
          }
        ]
      },
      {
        "title": "Area Generation (MW)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 18},
        "targets": [
          {
            "expr": "dems_area_generation_mw{area=\"A\"}",
            "legendFormat": "Area A"
          },
          {
            "expr": "dems_area_generation_mw{area=\"B\"}",
            "legendFormat": "Area B"
          },
          {
            "expr": "dems_area_generation_mw{area=\"C\"}",
            "legendFormat": "Area C"
          }
        ]
      },
      {
        "title": "Area Load (MW)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 18},
        "targets": [
          {
            "expr": "dems_area_load_mw{area=\"A\"}",
            "legendFormat": "Area A"
          },
          {
            "expr": "dems_area_load_mw{area=\"B\"}",
            "legendFormat": "Area B"
          },
          {
            "expr": "dems_area_load_mw{area=\"C\"}",
            "legendFormat": "Area C"
          }
        ]
      },
      {
        "title": "Area Net Export (MW)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 18},
        "targets": [
          {
            "expr": "dems_area_net_export_mw{area=\"A\"}",
            "legendFormat": "Area A"
          },
          {
            "expr": "dems_area_net_export_mw{area=\"B\"}",
            "legendFormat": "Area B"
          },
          {
            "expr": "dems_area_net_export_mw{area=\"C\"}",
            "legendFormat": "Area C"
          }
        ]
      },
      {
        "title": "Solar & Wind Output (MW)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
        "targets": [
          {
            "expr": "dems_solar_output_mw",
            "legendFormat": "Solar"
          },
          {
            "expr": "dems_wind_output_mw",
            "legendFormat": "Wind"
          }
        ]
      },
      {
        "title": "Battery Status",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
        "targets": [
          {
            "expr": "dems_battery_soc_percent",
            "legendFormat": "SOC (%)"
          },
          {
            "expr": "dems_battery_power_mw",
            "legendFormat": "Power (MW)"
          }
        ]
      },
      {
        "title": "EV Charging (MW)",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 34},
        "targets": [
          {
            "expr": "dems_ev_current_power_mw",
            "legendFormat": "Current Power"
          },
          {
            "expr": "dems_ev_max_power_mw",
            "legendFormat": "Max Power"
          }
        ]
      },
      {
        "title": "Demand Response (MW)",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 34},
        "targets": [
          {
            "expr": "dems_dr_curtailed_mw",
            "legendFormat": "Curtailed"
          },
          {
            "expr": "dems_dr_available_mw",
            "legendFormat": "Available"
          }
        ]
      },
      {
        "title": "Power Flow Performance",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 40},
        "targets": [
          {
            "expr": "dems_power_flow_duration_ms",
            "legendFormat": "Duration (ms)"
          },
          {
            "expr": "dems_power_flow_iterations",
            "legendFormat": "Iterations"
          }
        ]
      },
      {
        "title": "Line Overloads",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 40},
        "targets": [
          {
            "expr": "dems_line_overloads",
            "legendFormat": "Line Overloads"
          },
          {
            "expr": "dems_trafo_overloads",
            "legendFormat": "Transformer Overloads"
          }
        ]
      }
    ],
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    }
  }
}
