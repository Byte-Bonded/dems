{
  "dashboard": {
    "title": "IEEE 39-Bus Power System - Complete Dashboard",
    "tags": ["ieee39", "power-system", "der", "monitoring"],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-5m",
      "to": "now"
    },
    "refresh": "5s",
    "panels": [
      {
        "id": 1,
        "title": "System Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
        "targets": [{
          "expr": "ieee39_system_secure",
          "legendFormat": "System Secure"
        }],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "1", "text": "SECURE"},
              {"type": "value", "value": "0", "text": "ALERT"}
            ],
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Total Generation",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
        "targets": [{
          "expr": "ieee39_total_generation_mw",
          "legendFormat": "Generation"
        }],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "decimals": 1,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5000, "color": "yellow"},
                {"value": 6000, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Total Load",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
        "targets": [{
          "expr": "ieee39_total_load_mw",
          "legendFormat": "Load"
        }],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "decimals": 1,
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 4,
        "title": "System Losses",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
        "targets": [{
          "expr": "ieee39_total_losses_mw",
          "legendFormat": "Losses"
        }],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "decimals": 1,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 100, "color": "yellow"},
                {"value": 200, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Frequency",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
        "targets": [{
          "expr": "ieee39_system_frequency_hz",
          "legendFormat": "Frequency"
        }],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "Hz",
            "decimals": 3,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 49.5, "color": "yellow"},
                {"value": 49.8, "color": "green"},
                {"value": 50.2, "color": "yellow"},
                {"value": 50.5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Voltage Range",
        "type": "stat",
        "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
        "targets": [
          {
            "expr": "ieee39_voltage_min_pu",
            "legendFormat": "Min"
          },
          {
            "expr": "ieee39_voltage_max_pu",
            "legendFormat": "Max"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "pu",
            "decimals": 4,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 0.9, "color": "green"},
                {"value": 1.1, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Power Flow - Generation vs Load",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "ieee39_total_generation_mw",
            "legendFormat": "Generation"
          },
          {
            "expr": "ieee39_total_load_mw",
            "legendFormat": "Load"
          },
          {
            "expr": "ieee39_total_losses_mw",
            "legendFormat": "Losses"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 8,
        "title": "System Frequency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 4},
        "targets": [{
          "expr": "ieee39_system_frequency_hz",
          "legendFormat": "Frequency"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "Hz",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 49.0, "color": "red"},
                {"value": 49.5, "color": "yellow"},
                {"value": 49.8, "color": "green"},
                {"value": 50.2, "color": "yellow"},
                {"value": 51.0, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Voltage Profile",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 4},
        "targets": [
          {
            "expr": "ieee39_voltage_min_pu",
            "legendFormat": "Min Voltage"
          },
          {
            "expr": "ieee39_voltage_max_pu",
            "legendFormat": "Max Voltage"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "pu",
            "min": 0.85,
            "max": 1.15,
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 20
            }
          }
        }
      },
      {
        "id": 10,
        "title": "DER Generation Mix",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "sum(ieee39_solar_generation_mw)",
            "legendFormat": "Solar PV"
          },
          {
            "expr": "sum(ieee39_wind_generation_mw)",
            "legendFormat": "Wind"
          },
          {
            "expr": "sum(ieee39_bess_power_mw > 0)",
            "legendFormat": "BESS Discharge"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          },
          "pieType": "donut"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MW"
          }
        }
      },
      {
        "id": 11,
        "title": "Total DER Contribution",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
        "targets": [
          {
            "expr": "ieee39_total_der_generation_mw",
            "legendFormat": "DER Generation"
          },
          {
            "expr": "ieee39_total_der_storage_mw",
            "legendFormat": "Storage Dispatch"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20,
              "stacking": {"mode": "normal"}
            }
          }
        }
      },
      {
        "id": 12,
        "title": "Generator Performance",
        "type": "table",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
        "targets": [{
          "expr": "ieee39_generator_power_mw",
          "legendFormat": "{{bus}} - {{gen_type}}",
          "format": "table",
          "instant": true
        }],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "Value", "desc": true}]
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "decimals": 1
          }
        }
      },
      {
        "id": 13,
        "title": "Solar PV Generation",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 20},
        "targets": [{
          "expr": "ieee39_solar_generation_mw",
          "legendFormat": "{{name}} ({{bus}})"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 14,
        "title": "Wind Generation",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 20},
        "targets": [{
          "expr": "ieee39_wind_generation_mw",
          "legendFormat": "{{name}} ({{bus}})"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 15,
        "title": "Battery Energy Storage - Power",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 26},
        "targets": [{
          "expr": "ieee39_bess_power_mw",
          "legendFormat": "{{name}} ({{bus}})"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "custom": {
              "drawStyle": "line",
              "axisPlacement": "auto"
            },
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 16,
        "title": "Battery State of Charge",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 26},
        "targets": [{
          "expr": "ieee39_bess_soc_percent",
          "legendFormat": "{{name}} ({{bus}})"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 5
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 20, "color": "yellow"},
                {"value": 30, "color": "green"},
                {"value": 90, "color": "yellow"}
              ]
            }
          }
        }
      },
      {
        "id": 17,
        "title": "EV Charging Stations",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 32},
        "targets": [{
          "expr": "ieee39_ev_charging_power_mw",
          "legendFormat": "{{name}} ({{bus}})"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 18,
        "title": "EV Connected Count",
        "type": "stat",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "sum(ieee39_ev_connected_count)",
            "legendFormat": "Total Connected"
          },
          {
            "expr": "sum(ieee39_ev_v2g_capable_count)",
            "legendFormat": "V2G Capable"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value_and_name",
          "orientation": "horizontal"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "vehicles"
          }
        }
      },
      {
        "id": 19,
        "title": "Demand Response - Load Control",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 38},
        "targets": [
          {
            "expr": "ieee39_dr_load_mw",
            "legendFormat": "{{name}} Current Load"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            }
          }
        }
      },
      {
        "id": 20,
        "title": "Demand Response - Reduction",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 38},
        "targets": [{
          "expr": "ieee39_dr_reduction_mw",
          "legendFormat": "{{name}} Reduction"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 50
            },
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 21,
        "title": "Load Control Test - Applied Load Increase",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 44},
        "targets": [{
          "expr": "ieee39_load_increase_applied_mw",
          "legendFormat": "Load Increase"
        }],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "decimals": 1,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 50, "color": "yellow"},
                {"value": 100, "color": "orange"}
              ]
            }
          }
        }
      },
      {
        "id": 22,
        "title": "Load Control Test - DER Response",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 44},
        "targets": [{
          "expr": "ieee39_der_response_total_mw",
          "legendFormat": "DER Response"
        }],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MW",
            "decimals": 1,
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 23,
        "title": "Load Control Success",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 44},
        "targets": [{
          "expr": "ieee39_load_control_success",
          "legendFormat": "Success"
        }],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "1", "text": "SUCCESS"},
              {"type": "value", "value": "0", "text": "FAILED"}
            ],
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 24,
        "title": "Power Flow Convergence",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 44},
        "targets": [{
          "expr": "ieee39_power_flow_converged",
          "legendFormat": "Converged"
        }],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": "1", "text": "CONVERGED"},
              {"type": "value", "value": "0", "text": "FAILED"}
            ],
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 25,
        "title": "Power Flow Performance",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 48},
        "targets": [{
          "expr": "rate(ieee39_power_flow_duration_seconds_sum[1m]) / rate(ieee39_power_flow_duration_seconds_count[1m])",
          "legendFormat": "Avg Duration"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3,
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            }
          }
        }
      },
      {
        "id": 26,
        "title": "Metrics Update Rate",
        "type": "timeseries",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 48},
        "targets": [{
          "expr": "rate(ieee39_metrics_update_count[1m])",
          "legendFormat": "Updates/min"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10
            }
          }
        }
      }
    ],
    "schemaVersion": 38,
    "version": 1
  }
}
