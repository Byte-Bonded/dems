# ============================================================
# DEMS Grid Simulation — API + Simulation Container
# 117-bus IEEE 39-bus Tri-Area SuperGrid
# ============================================================
FROM python:3.11-slim AS base

# Labels
LABEL maintainer="dems-team"
LABEL description="DEMS Grid Simulation — IEEE 39-bus Tri-Area SuperGrid with RL"

# Prevent Python from writing .pyc and enable unbuffered stdout
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System deps (gcc for numba/numpy wheels)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

# ---------- dependency layer (cached separately) ----------
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir numba   # pandapower speedup

# ---------- application layer ----------
COPY src/ src/
COPY config/ config/
COPY tests/ tests/

# Smoke-test: import the simulation module
RUN python -c "from src.simulation import SuperGrid; print('SuperGrid import OK')"

# Default: run the FastAPI server
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
