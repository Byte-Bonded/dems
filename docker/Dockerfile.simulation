# ============================================================
# DEMS Grid Simulation — Headless Simulation / RL Training
# Runs the 117-bus IEEE 39-bus dynamic simulation without the API
# ============================================================
FROM python:3.11-slim

LABEL maintainer="dems-team"
LABEL description="DEMS Grid Simulation — headless RL training container"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ \
    && rm -rf /var/lib/apt/lists/*

# Dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir numba

# Application code
COPY src/ src/
COPY config/ config/
COPY tests/ tests/

# Validate the build
RUN python -c "\
from src.simulation import GridOrchestrator, ScenarioConfig; \
print('GridOrchestrator import OK'); \
"

# Expose Prometheus metrics port
EXPOSE 9100

# Default: run tests, then start a training loop placeholder
# Override with: docker run dems-simulation python -m your_training_script
CMD ["python", "-m", "pytest", "tests/test_simulation.py", "-v", "--tb=short"]
